# Copy to .env and adjust for local development
DEBUG=True
SECRET_KEY=django-insecure-change-me
ALLOWED_HOSTS=localhost,127.0.0.1

# Email delivery
# Local dev uses the console backend by default - it prints emails to stdout and
# sends no real mail, so none of the SMTP vars below are needed for local dev.
# Set EMAIL_BACKEND to the SMTP backend and fill in the rest only for real sending.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=chores@example.com
EMAIL_HOST_PASSWORD=change-me
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=chores@localhost

# Web Push (VAPID) - generate a keypair once, see _docs/push.md. Leave blank
# for local dev / tests; no push is sent from code yet.
VAPID_PUBLIC_KEY=BJ_placeholder_base64url_public_key
VAPID_PRIVATE_KEY=placeholder_base64url_private_key
VAPID_ADMIN_EMAIL=you@example.com
